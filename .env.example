# Server-side variables. Set them in Docker / hosting, or use node --env-file=.env.
PORT=3001
PUBLIC_URL=https://rokugan.zarya-boardgames.ru
MATCHES_DIR=/app/data/matches
# Generate a unique value and configure the same secret on Zarya's server.
PLATFORM_SECRET=
# Optional extra CORS origins, comma-separated (no trailing slashes).
ALLOWED_ORIGINS=
