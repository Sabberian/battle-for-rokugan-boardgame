{
  "name": "battle-for-rokugan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/engine",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "dev": "npm run dev -w @rokugan/client",
    "serve": "npm run start -w @rokugan/server",
    "check": "tsc --noEmit",
    "start": "npm run serve",
    "play": "npm run build && npm run serve",
    "test:platform": "node scripts/platform-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
